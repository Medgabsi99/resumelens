# ─── Gemini AI ─────────────────────────────────────────────
GOOGLE_AI_API_KEY=your-gemini-2.5-api-key

# ─── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Upstash Redis Rate Limiter ───────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ─── Stripe Billing ───────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# One-time product price ID (from Stripe Dashboard → Products)
STRIPE_PRICE_ID_ONE_TIME=price_...
# Monthly subscription price ID
STRIPE_PRICE_ID_MONTHLY=price_...

# ─── Application URL ──────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://resumelens.vercel.app
NEXT_PUBLIC_BASE_URL=https://resumelens.vercel.app
